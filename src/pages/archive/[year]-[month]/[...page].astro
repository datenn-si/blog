---
import type { GetStaticPaths } from "astro";

import PostList from "@/components/PostList.astro";
import { postsPerPage } from "@/constants";
import Layout from "@/layouts/Layout.astro";
import {
  getPosts,
  groupArchive,
  monthParam,
  pageDocumentTitle,
  postsInMonth,
} from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return groupArchive(posts).flatMap((yearGroup) =>
    yearGroup.months.flatMap((monthGroup) =>
      paginate(postsInMonth(posts, yearGroup.year, monthGroup.month), {
        params: {
          year: String(yearGroup.year),
          month: monthParam(monthGroup.month),
        },
        props: { year: yearGroup.year, month: monthGroup.month },
        pageSize: postsPerPage,
      }),
    ),
  );
}) satisfies GetStaticPaths;

const { page, year, month } = Astro.props;
const heading = `${year}年${month}月`;
---

<Layout
  title={pageDocumentTitle(heading, page.currentPage)}
  description={`${year}年${month}月の投稿一覧です。`}
>
  <PostList heading={heading} page={page} />
</Layout>
