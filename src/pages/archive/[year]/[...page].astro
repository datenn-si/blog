---
import type { GetStaticPaths } from "astro";

import { postsPerPage } from "@/constants";
import PaginationLayout from "@/layouts/PaginationLayout.astro";
import { getPosts, groupArchive, postsInYear } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return groupArchive(posts).flatMap((yearGroup) =>
    paginate(postsInYear(posts, yearGroup.year), {
      params: { year: String(yearGroup.year) },
      props: { year: yearGroup.year },
      pageSize: postsPerPage,
    }),
  );
}) satisfies GetStaticPaths;

const { page, year } = Astro.props;
---

<PaginationLayout
  heading={`${year}年`}
  description={`${year}年の投稿一覧です。`}
  page={page}
/>
