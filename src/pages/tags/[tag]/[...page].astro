---
import type { GetStaticPaths } from "astro";

import { postsPerPage } from "@/constants";
import PaginationLayout from "@/layouts/PaginationLayout.astro";
import { countTags, getPosts, postsWithTag } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return countTags(posts).flatMap((item) =>
    paginate(postsWithTag(posts, item.tag), {
      params: { tag: item.tag },
      props: { tag: item.tag },
      pageSize: postsPerPage,
    }),
  );
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props;
---

<PaginationLayout
  heading={`タグ「${tag}」`}
  description={`「${tag}」タグが付いた投稿の一覧です。`}
  page={page}
/>
