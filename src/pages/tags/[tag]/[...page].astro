---
import type { GetStaticPaths } from 'astro';

import PostList from '@/components/PostList.astro';
import { postsPerPage } from '@/constants';
import Layout from '@/layouts/Layout.astro';
import { countTags, getPosts, pageDocumentTitle, postsWithTag } from '@/lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return countTags(posts).flatMap((item) =>
    paginate(postsWithTag(posts, item.tag), {
      params: { tag: item.tag },
      props: { tag: item.tag },
      pageSize: postsPerPage,
    }),
  );
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props;
const heading = `タグ「${tag}」`;
---

<Layout
  title={pageDocumentTitle(heading, page.currentPage)}
  description={`${tag} タグが付いた投稿の一覧です。`}
>
  <PostList heading={heading} page={page} />
</Layout>
