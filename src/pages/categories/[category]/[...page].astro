---
import type { GetStaticPaths } from "astro";

import { postsPerPage } from "@/constants";
import PaginationLayout from "@/layouts/PaginationLayout.astro";
import { countCategories, getPosts, postsWithCategory } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return countCategories(posts).flatMap((item) =>
    paginate(postsWithCategory(posts, item.category), {
      params: { category: item.category },
      props: { category: item.category },
      pageSize: postsPerPage,
    }),
  );
}) satisfies GetStaticPaths;

const { page, category } = Astro.props;
---

<PaginationLayout
  heading={`カテゴリ「${category}」`}
  description={`「${category}」カテゴリの記事一覧です。`}
  page={page}
/>
