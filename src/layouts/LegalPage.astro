---
import Layout from "@/layouts/Layout.astro";
import "@/styles/article.css";

type Props = {
  frontmatter: { title: string; description: string };
};

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <article>
    <h1 class="text-2xl font-bold">{frontmatter.title}</h1>
    <div
      class="prose prose-sm mt-6 max-w-none text-ink dark:prose-invert [--tw-prose-body:var(--color-ink)] [--tw-prose-headings:var(--color-ink)] [--tw-prose-counters:var(--color-ink)] [--tw-prose-bullets:var(--color-ink)] [--tw-prose-links:var(--color-accent)] prose-headings:scroll-m-16"
    >
      <slot />
    </div>
  </article>
</Layout>
