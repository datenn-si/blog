---
import type { Page } from "astro";

type Props = {
  page: Page<unknown>;
};

const { page } = Astro.props;

const windows = [
  { breakpoint: "base", delta: 0 },
  { breakpoint: "sm", delta: 4 },
] as const;

const maxDelta = windows[windows.length - 1].delta;
const start = Math.max(1, page.currentPage - maxDelta);
const end = Math.min(page.lastPage, page.currentPage + maxDelta);
const numbers = Array.from(
  { length: end - start + 1 },
  (_, index) => start + index,
).filter((number) => number > 1 && number < page.lastPage);
const pageOne = page.url.first ?? (page.url.current || "/");

function pageHref(target: number): string {
  if (target === page.currentPage) return page.url.current;
  if (target === 1) return pageOne;
  if (target === page.lastPage && page.url.last) return page.url.last;
  const base = pageOne.endsWith("/") ? pageOne : `${pageOne}/`;
  return `${base}${target}/`;
}

function numberClass(number: number): string | undefined {
  if (number === 1 || number === page.lastPage) return undefined;
  const distance = Math.abs(number - page.currentPage);
  const shownAt = windows.find((window) => window.delta >= distance);
  if (!shownAt || shownAt.breakpoint === "base") return undefined;
  return `win-${shownAt.breakpoint}`;
}

function hasGap(delta: number, side: "left" | "right"): boolean {
  if (side === "left") return page.currentPage - delta > 2;
  return page.currentPage + delta < page.lastPage - 1;
}

function ellipsisClass(side: "left" | "right"): string | null {
  if (!hasGap(windows[0].delta, side)) return null;
  const hideAt = windows.find((window) => !hasGap(window.delta, side));
  if (!hideAt) return "";
  return `until-${hideAt.breakpoint}`;
}

const leftEllipsis = ellipsisClass("left");
const rightEllipsis = ellipsisClass("right");
---

<nav aria-label="ページネーション">
  <ul class="pager">
    {
      page.url.prev ? (
        <li>
          <a href={page.url.prev} aria-label="前のページ">
            &lt;
          </a>
        </li>
      ) : (
        <li>
          <span aria-disabled="true" aria-label="前のページ">
            &lt;
          </span>
        </li>
      )
    }
    {
      (
        <li>
          {page.currentPage === 1 ? (
            <span aria-current="page">1</span>
          ) : (
            <a href={pageHref(1)} aria-label="ページ 1">
              1
            </a>
          )}
        </li>
      )
    }
    {
      leftEllipsis !== null && (
        <li class={leftEllipsis || undefined}>
          <button
            type="button"
            data-page-jump
            data-base={pageOne}
            data-last={page.lastPage}
            aria-label="ページを指定して移動"
          >
            ...
          </button>
        </li>
      )
    }
    {
      numbers.map((number) => (
        <li class={numberClass(number)}>
          {number === page.currentPage ? (
            <span aria-current="page">{number}</span>
          ) : (
            <a href={pageHref(number)} aria-label={`ページ ${number}`}>
              {number}
            </a>
          )}
        </li>
      ))
    }
    {
      rightEllipsis !== null && (
        <li class={rightEllipsis || undefined}>
          <button
            type="button"
            data-page-jump
            data-base={pageOne}
            data-last={page.lastPage}
            aria-label="ページを指定して移動"
          >
            ...
          </button>
        </li>
      )
    }
    {
      page.lastPage > 1 && (
        <li>
          {page.currentPage === page.lastPage ? (
            <span aria-current="page">{page.lastPage}</span>
          ) : (
            <a
              href={pageHref(page.lastPage)}
              aria-label={`ページ ${page.lastPage}`}
            >
              {page.lastPage}
            </a>
          )}
        </li>
      )
    }
    {
      page.url.next ? (
        <li>
          <a href={page.url.next} aria-label="次のページ">
            &gt;
          </a>
        </li>
      ) : (
        <li>
          <span aria-disabled="true" aria-label="次のページ">
            &gt;
          </span>
        </li>
      )
    }
  </ul>
</nav>

<script>
  for (const node of document.querySelectorAll("[data-page-jump]")) {
    if (!(node instanceof HTMLButtonElement)) continue;

    node.addEventListener("click", () => {
      const last = Number(node.dataset.last);
      const base = node.dataset.base || "/";
      if (!Number.isInteger(last) || last < 1) return;

      const answer = window.prompt(`ページへ移動(1~${last})：`);
      if (answer === null) return;

      const value = answer.trim();
      if (!/^\d+$/.test(value)) return;

      const target = Number(value);
      if (target < 1 || target > last) return;

      const basePath = base.endsWith("/") ? base : `${base}/`;
      window.location.href = target === 1 ? basePath : `${basePath}${target}/`;
    });
  }
</script>

<style>
  @reference "@/styles/global.css";

  .pager {
    @apply mt-8 flex cursor-default flex-wrap items-center justify-center gap-1;
  }

  .pager :is(a, span, button) {
    @apply inline-flex h-8 min-w-8 cursor-default items-center justify-center rounded-control border border-line px-2;
  }

  .pager :is(a, button) {
    @apply cursor-pointer bg-surface;
  }

  .pager :is(a, button):hover {
    @apply bg-canvas text-accent;
  }

  .pager [aria-current="page"] {
    @apply border-highlight bg-highlight text-highlight-ink;
  }

  .pager [aria-disabled="true"] {
    @apply border-line bg-canvas text-muted opacity-40;
  }

  .win-sm {
    @apply hidden sm:block;
  }

  .win-md {
    @apply hidden md:block;
  }

  .win-lg {
    @apply hidden lg:block;
  }

  .win-xl {
    @apply hidden xl:block;
  }

  .win-2xl {
    @apply hidden 2xl:block;
  }

  .until-sm {
    @apply sm:hidden;
  }

  .until-md {
    @apply md:hidden;
  }

  .until-lg {
    @apply lg:hidden;
  }

  .until-xl {
    @apply xl:hidden;
  }

  .until-2xl {
    @apply 2xl:hidden;
  }
</style>
