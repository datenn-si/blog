---
// @ts-expect-error Pagefind exposes this stylesheet without a TypeScript declaration.
import "@pagefind/component-ui/css";

import { Image } from "astro:assets";
import icon from "@/assets/icon.png";
import { navigationItems, siteConfig } from "@/constants";

const themeOptions = [
  { value: "auto", label: "自動", icon: "icon-[ic--baseline-devices]" },
  { value: "light", label: "ライト", icon: "icon-[ic--baseline-light-mode]" },
  { value: "dark", label: "ダーク", icon: "icon-[ic--baseline-dark-mode]" },
] as const;
---

<header class="sticky top-0 z-50 h-12 border-b border-line bg-surface">
  <div
    class="mx-auto flex h-full w-full max-w-3xl items-center gap-1 px-4 md:gap-4"
  >
    <a
      href="/"
      class="mr-auto font-bold text-lg text-ink flex items-center gap-1"
    >
      <Image
        src={icon}
        alt="favicon"
        width={30}
        height={30}
        class="rounded-sm"
        loading="eager"
        fetchpriority="high"
      />{siteConfig.siteName}</a
    >
    <div class="order-1 flex items-center md:order-3">
      <div class="group relative">
        <button
          id="search-button"
          type="button"
          class="grid size-9 place-items-center cursor-pointer"
          aria-haspopup="dialog"
          aria-describedby="search-tooltip"
          aria-label="検索"
        >
          <span class="icon-[mdi--magnify] text-2xl" aria-hidden="true"></span>
        </button>
        <span id="search-tooltip" class="theme-tooltip" role="tooltip"
          >検索</span
        >
      </div>
      <div class="theme group relative">
        <button
          type="button"
          class="theme-button relative z-70 grid size-9 place-items-center cursor-pointer"
          aria-expanded="false"
          aria-controls="theme-menu"
          aria-haspopup="menu"
          aria-describedby="theme-tooltip"
          aria-label="カラーモード"
        >
          {
            themeOptions.map((option) => (
              <span
                class:list={[option.icon, "theme-icon hidden text-2xl"]}
                data-theme-icon={option.value}
                aria-hidden="true"
              />
            ))
          }
        </button>
        <span id="theme-tooltip" class="theme-tooltip" role="tooltip"
          >カラーモード</span
        >
        <div class="theme-backdrop fixed inset-0 z-60 touch-none" hidden></div>
        <div
          id="theme-menu"
          class="theme-menu absolute top-[calc(100%+0.25rem)] right-0 z-70 flex min-w-36 flex-col rounded-control border border-line bg-surface p-1 text-ink shadow-md"
          role="menu"
          aria-label="カラーモードメニュー"
          hidden
        >
          {
            themeOptions.map((option) => (
              <button
                type="button"
                role="menuitemradio"
                class="theme-option flex w-full cursor-pointer items-center gap-2 rounded-control border-0 bg-transparent px-3 py-2 text-left text-inherit [font:inherit] hover:bg-ink/8 focus-visible:bg-ink/8 aria-checked:bg-highlight aria-checked:text-highlight-ink aria-checked:hover:bg-highlight aria-checked:focus-visible:bg-highlight"
                data-theme-value={option.value}
                aria-checked="false"
              >
                <span
                  class:list={[option.icon, "text-lg"]}
                  aria-hidden="true"
                />
                {option.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <div class="theme group relative order-2">
      <button
        type="button"
        popovertarget="site-navigation"
        aria-label="ナビゲーションを開閉"
        class="menu-toggle grid size-9 place-items-center cursor-pointer md:hidden"
      >
        <span class="menu-open icon-[mdi--menu] text-2xl" aria-hidden="true"
        ></span>
        <span
          class="menu-close icon-[mdi--close] hidden text-2xl"
          aria-hidden="true"></span>
      </button>
      <span
        id="theme-tooltip"
        class="theme-tooltip theme-tooltip-right"
        role="tooltip">ナビゲーションを開閉</span
      >
    </div>
    <nav
      id="site-navigation"
      popover="auto"
      aria-label="ナビゲーション"
      class="fixed inset-x-0 top-12 z-50 m-0 hidden max-md:h-[calc(100dvh-3rem)] w-full max-w-none flex-col items-stretch gap-0 overflow-y-auto overscroll-y-contain border-0 border-t border-line bg-surface px-4 py-4 text-ink shadow-none [&:popover-open]:flex md:static md:order-2 md:flex md:w-auto md:flex-row md:items-center md:gap-4 md:overflow-visible md:border-0 md:bg-transparent md:p-0"
    >
      {
        navigationItems.map((item) => (
          <a
            href={item.href}
            class="border-b border-line px-2 py-4 last:border-b-0 md:border-0 md:px-0 md:py-0"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <pagefind-config bundle-path="/pagefind/"></pagefind-config>
  <pagefind-modal>
    <pagefind-modal-header>
      <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary></pagefind-summary>
      <div class="mb-2 flex flex-wrap gap-2">
        <pagefind-filter-dropdown filter="カテゴリ" label="カテゴリ"
        ></pagefind-filter-dropdown>
        <pagefind-filter-dropdown filter="タグ" label="タグ"
        ></pagefind-filter-dropdown>
      </div>
      <pagefind-results></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>
  </pagefind-modal>
</header>

<script>
  import "@pagefind/component-ui";
  import { initSearch } from "@/scripts/search";
  import { initTheme } from "@/scripts/theme";

  initTheme();
  initSearch();
</script>

<style>
  @reference "@/styles/global.css";

  pagefind-modal:not(:defined),
  pagefind-config:not(:defined) {
    display: none;
  }

  header:has(#site-navigation:popover-open) .menu-open {
    @apply hidden;
  }

  header:has(#site-navigation:popover-open) .menu-close {
    @apply block;
  }

  :global(html[data-theme="light"]) .theme-icon[data-theme-icon="light"],
  :global(html[data-theme="dark"]) .theme-icon[data-theme-icon="dark"],
  :global(html:not([data-theme="light"]):not([data-theme="dark"]))
    .theme-icon[data-theme-icon="auto"] {
    @apply block;
  }

  header:has(:global(dialog.pf-modal[open])) #search-tooltip {
    @apply hidden;
  }

  @media (hover: none) {
    pagefind-modal-footer {
      display: none !important;
    }

    pagefind-modal-body {
      border-bottom-left-radius: 12px !important;
      border-bottom-right-radius: 12px !important;
    }
  }

  :global(dialog.pf-modal .pf-dropdown-menu) {
    max-height: min(17.5rem, 50dvh) !important;
  }

  .theme:has(.theme-menu:not([hidden])) [role="tooltip"],
  .theme:has(.theme-button:focus:not(:focus-visible)):not(:hover)
    [role="tooltip"] {
    @apply hidden;
  }
</style>
