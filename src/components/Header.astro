---
import { navigationItems, siteConfig } from "@/constants";
---

<header class="h-12 border-b border-line bg-surface">
  <div
    class="mx-auto flex h-full w-full max-w-3xl items-center justify-between gap-4 px-4"
  >
    <a href="/" class="font-bold text-ink">{siteConfig.siteName}</a>
    <button
      type="button"
      popovertarget="site-navigation"
      aria-label="ナビゲーションを開閉"
      class="menu-toggle grid size-9 place-items-center md:hidden"
    >
      <span class="menu-open icon-[mdi--menu] text-2xl" aria-hidden="true"
      ></span>
      <span class="menu-close icon-[mdi--close] text-2xl" aria-hidden="true"
      ></span>
    </button>
    <nav
      id="site-navigation"
      popover="auto"
      aria-label="ナビゲーション"
      class="fixed inset-x-0 top-12 z-50 m-0 flex h-[calc(100dvh-3rem)] w-full max-w-none flex-col items-stretch gap-0 overflow-y-auto border-0 border-t border-line bg-surface px-4 py-4 text-ink shadow-none md:static md:ml-auto md:w-auto md:flex-row md:items-center md:gap-4 md:overflow-visible md:border-0 md:bg-transparent md:p-0"
    >
      {
        navigationItems.map((item) => (
          <a
            href={item.href}
            class="border-b border-line px-2 py-4 last:border-b-0 md:border-0 md:px-0 md:py-0"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  :global(html:has(#site-navigation:popover-open)) {
    overflow: hidden;
  }

  .menu-close {
    display: none;
  }

  .menu-toggle:has(+ #site-navigation:popover-open) .menu-open {
    display: none;
  }

  .menu-toggle:has(+ #site-navigation:popover-open) .menu-close {
    display: block;
  }

  #site-navigation:not(:popover-open) {
    display: none;
  }

  @media (min-width: 48rem) {
    #site-navigation:not(:popover-open) {
      display: flex;
    }
  }
</style>
